# Copy to .env for local Node. Do not commit .env.
# Values below are public. Secrets are server-only and must not use a VITE_ name,
# or Vite will be able to inline them if client code references them.

# Active tenant (public)
VITE_KF_API_ORIGIN=https://development-refexgroup.kissflow.com
VITE_KF_ACCOUNT_ID=
VITE_KF_BASE_URL=https://development-refexgroup.kissflow.com

# Live / production (public)
VITE_KF_LIVE_API_ORIGIN=https://refexgroup.kissflow.com
VITE_KF_LIVE_ACCOUNT_ID=

# Development (public)
VITE_KF_DEV_API_ORIGIN=https://development-refexgroup.kissflow.com
VITE_KF_DEV_ACCOUNT_ID=

# App / case / process IDs
VITE_KF_TRACKER_APP_ID=Project_Management_Tracker_A00
VITE_KF_TRACKER_APP_URL=https://refexgroup.kissflow.com/view/application/Project_Management_Tracker_A00
VITE_KF_PROJECTS_APP_ID=Project_Management_A01
VITE_KF_TASKS_APP_ID=Project_Management_A01
VITE_KF_SUBTASKS_APP_ID=Project_Management_A01
VITE_KF_CASE_ID=Project_Management_A01
VITE_KF_TASK_PROCESS_ID=Project_Sub_Task_A01
VITE_KF_SUBTASK_PROCESS_ID=Sub_Task_Process_A00
VITE_KF_CR_PROCESS_ID=Change_Request_A01

# Popups
VITE_KF_PROJECT_POPUP_ID=Popup_RWeNJp0JqJ
VITE_KF_TASK_POPUP_ID=Popup_bEJJgrdutd
VITE_KF_SUBTASK_POPUP_ID=Popup_QTJQAyhxOR
VITE_KF_CR_POPUP_ID=Popup_mS9FovL2TO

# Optional: Refex One IAM (public URL)
# (?email= / ?user_email=), session, or GET {VITE_IAM_API_URL}/auth/me
VITE_IAM_API_URL=https://refexone.com/api/v1

# Server-only secrets. The Node process reads these. Do not put them in the React bundle.
# USER_MASTER_TOKEN=
# KF_ACCESS_KEY_ID=
# KF_ACCESS_KEY_SECRET=
# KF_LIVE_ACCESS_KEY_ID=
# KF_LIVE_ACCESS_KEY_SECRET=
# PM_CREATE_WEBHOOK_URL=
# PM_SYNC_TOKEN=

# PM_DATA_DIR=data
# PORT=8080
# Cloud Run bucket for pm-tracker/user-master-snapshot.json and tracker-role-overrides.json
# PM_GCS_BUCKET=

# Refex One SSO. Unauthenticated visits redirect to /login?oidc_redirect= (same as P2P).
# Logout returns to /launcher.
# VITE_REFEXONE_ORIGIN=https://refexone.com
# REFEXONE_ORIGIN=https://refexone.com
